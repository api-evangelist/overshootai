        {
          "id": "04d906d4-1065-47bd-8382-9b7e64cb844e",
          "name": "Create stream",
          "request": {
            "name": "Create stream",
            "description": {
              "content": "Creates a live stream and returns a publish token. The current request body is\nempty. The retained frame history is fixed at 600 seconds.\n\nThe publish token is scoped to this stream and grants media publish permissions.\nRenew it through [`/keepalive`](#tag/Streams/operation/keepaliveStream) before it\nexpires.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "streams"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional hint to route the request to the region that owns the stream. If the\nrequest reaches the wrong region the API returns `409` with a `region_error` body.\n",
